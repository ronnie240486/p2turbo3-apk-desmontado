<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#11ffc107" android:endColor="#11ffc107" android:angle="0.0" />
            <corners android:radius="@dimen/_2sdp" />
            <stroke android:width="2.0dip" android:color="#ffff9800" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#01ffffff" android:endColor="#01ffffff" android:angle="0.0" />
            <corners android:radius="@dimen/_2sdp" />
            <stroke android:width="1.0dip" android:color="#00ffffff" />
        </shape>
    </item>
</selector>