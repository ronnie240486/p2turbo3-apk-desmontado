<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#ffff9800" android:endColor="#58ff9800" android:angle="0.0" android:centerColor="#ffff9800" />
            <corners android:radius="@dimen/_2sdp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:endColor="#00ff9800" android:angle="0.0" android:centerColor="#00ff9800" />
            <corners android:radius="@dimen/_2sdp" />
            <stroke android:width="1.0dip" android:color="#44ffffff" />
        </shape>
    </item>
</selector>