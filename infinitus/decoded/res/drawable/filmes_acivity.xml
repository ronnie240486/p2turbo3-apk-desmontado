<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#430181" />
            <corners android:radius="2.0dp" />
            <stroke android:width="2.0dp" android:color="#00018786" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#430181" />
            <corners android:radius="2.0dp" />
            <stroke android:width="1.0dp" android:color="#430181" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00091261" />
            <corners android:radius="2.0dp" />
            <stroke android:width="2.0dp" android:color="#003700b3" />
        </shape>
    </item>
</selector>
