<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#01ffc107" android:endColor="#ff0000" android:angle="0.0" android:centerColor="#640901" />
            <corners android:radius="@dimen/_2sdp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#00000000" android:endColor="#00000000" android:angle="0.0" />
            <corners android:radius="@dimen/_2sdp" />
            <stroke android:width="1.0dp" android:color="#00ffffff" />
        </shape>
    </item>
</selector>
