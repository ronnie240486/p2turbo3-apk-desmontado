<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/start_atv" />
            <corners android:radius="2.0dip" />
            <stroke android:width="2.0dip" android:color="#006200ee" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/start_atv" />
            <corners android:radius="2.0dip" />
            <stroke android:width="2.0dip" android:color="#006200ee" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#2d091261" />
            <corners android:radius="2.0dip" />
            <stroke android:width="2.0dip" android:color="#003700b3" />
        </shape>
    </item>
</selector>