    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/_4sdp" />
            <gradient android:startColor="@color/start_atv" android:endColor="@color/end_atv" android:angle="270.0" />
            <stroke android:width="@dimen/_1sdp" android:color="@color/white" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/_4sdp" />
