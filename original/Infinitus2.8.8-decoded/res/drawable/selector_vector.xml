<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#085d00ff" android:endColor="#085d00ff" android:angle="0.0" />
            <corners android:radius="@dimen/_8sdp" />
            <stroke android:width="2.0dip" android:color="#ff430181" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#22ffffff" android:endColor="#22ffffff" android:angle="0.0" />
            <corners android:radius="@dimen/_8sdp" />
            <stroke android:width="1.0dip" android:color="#00ffffff" />
        </shape>
    </item>
</selector>